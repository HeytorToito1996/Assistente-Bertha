# ============================================================================
#  ARQUIVO DE CONFIGURAÇÃO (VARIÁVEIS DE AMBIENTE) — PADRÃO
# ----------------------------------------------------------------------------
#  ANTES DE RODAR O SERVIDOR:
#    1. Renomeie este arquivo de ".env.example" para ".env"
#    2. Preencha as variáveis abaixo
#    Obs.: o arquivo ".env" NUNCA deve ser versionado (está no .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
#  PORTA DO SERVIDOR
# ----------------------------------------------------------------------------
PORT=3000

# ----------------------------------------------------------------------------
#  1) CHAVE DA API DO GOOGLE GEMINI (GEMINI_API_KEY)
# ----------------------------------------------------------------------------
#  COMO OBTER (gratuito):
#   - Acesse https://aistudio.google.com/apikey
#   - Clique em "Criar chave de API" e escolha/referencie seu projeto Google.
#   - Copie a chave gerada (começa com "AIza...") e cole abaixo no lugar de
#     "COLE_SUA_CHAVE_AQUI". NÃO deixe espaços e não use aspas.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# ----------------------------------------------------------------------------
#  MODELO PRINCIPAL DO GEMINI (OPCIONAL)
#  Padrão: gemini-3.6-flash. Consulte os modelos disponíveis em:
#  https://ai.google.dev/gemini-api/docs/models
# ----------------------------------------------------------------------------
# GEMINI_MODEL=gemini-3.6-flash

# ----------------------------------------------------------------------------
#  FILA DE FALLBACK (OPCIONAL)
#  Modelos usados automaticamente quando o principal estiver cheio (503) ou
#  indisponível (404/429/5xx). Separe por vírgula, do preferido para o último.
#  Mesmo sem preencher, o servidor já usa uma lista padrão de alternativas.
# ----------------------------------------------------------------------------
# GEMINI_MODEL_FALLBACKS=gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash-lite, gemini-2.5-flash-lite

# ----------------------------------------------------------------------------
#  2) CREDENCIAIS DO FIREBASE ADMIN (CONTA DE SERVIÇO / PRIVATE KEY JSON)
# ----------------------------------------------------------------------------
#  COMO OBTER (plano Spark — gratuito):
#   - Acesse o Console Firebase: https://console.firebase.google.com
#   - Selecione seu projeto (ou crie um novo; o plano Spark não cobra nada
#     para o Firestore).
#   - Menu: "Configurações do projeto" > aba "Contas de serviço"
#   - Clique em "Gerar nova chave privada" -> o navegador baixa um arquivo JSON.
#   - Salve esse JSON NA RAIZ deste projeto, ex.: "service-account-key.json".
#     CUIDADO: ele é secreto — já está bloqueado no .gitignore.
#   - Indique abaixo o caminho (relativo à raiz do projeto) desse arquivo:
# ----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=service-account-key.json

# ----------------------------------------------------------------------------
#  (OPCIONAL) ID DO PROJETO FIREBASE
#  Só preencha se o servidor precisar usar credenciais padrão do ambiente
#  (ex.: Google Cloud Run). Normalmente o valor já vem dentro do JSON da conta
#  de serviço e este item não precisa ser alterado.
# ----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=seu-projeto-id

# ============================================================================
#  ESTRUTURA DE DADOS NO FIRESTORE (plano Spark) — referência para o back-end
# ----------------------------------------------------------------------------
#  Coleção "usuarios"  -> documento com ID = userId
#    { nome: string, cargo: "aluno" | "secretaria" | "professor" }
#    Ex.: usuarios/ALUNO-001  { nome: "Maria", cargo: "aluno" }
#         usuarios/SEC-001    { nome: "Ana",   cargo: "secretaria" }
#
#  Coleção "historicos" -> subcoleção "mensagens" por usuário
#    historicos/{userId}/mensagens/{autoId}
#      { role: "user" | "model", text: string, criadoEm: timestamp }
#
#  ARQUIVOS ACEITOS EM POST /api/chat (Base64 em memória):
#    CSV, XLSX/XLS, TXT, HTML, MD, PDF, Word (.docx/.doc), imagens/áudios/vídeos
# ============================================================================